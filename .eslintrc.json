{
  "env": {
    "browser": true,
    "es6": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 2018,
    "sourceType": "module"
  },
  "globals": {
    "Battery": "readonly",
    "Message": "readonly",
    "module": "readonly",
    "Pebble": "readonly",
    "Poco": "readonly",
    "require": "readonly",
    "screen": "readonly",
    "watch": "readonly"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
  }
}
