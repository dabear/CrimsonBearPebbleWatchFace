{
  "name": "luped-cgm",
  "author": "Luped CGM contributors",
  "version": "0.1.0",
  "private": true,
  "description": "A Loop-styled CGM watchface for Pebble Time 2 and newer watches",
  "license": "MIT",
  "keywords": [
    "pebble-app",
    "watchface",
    "cgm",
    "loop"
  ],
  "pebble": {
    "displayName": "Luped CGM",
    "uuid": "bf32924c-4839-449e-9e56-ee190249acb2",
    "projectType": "moddable",
    "sdkVersion": "3",
    "enableMultiJS": false,
    "targetPlatforms": [
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "capabilities": [],
    "messageKeys": [
      "COMMAND",
      "DATA",
      "ERROR",
      "CONFIGURED",
      "DIAGNOSTICS"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "IMAGE_MENU_ICON",
          "file": "images/luped-menu-icon.png",
          "menuIcon": true,
          "targetPlatforms": [
            "emery",
            "gabbro"
          ],
          "memoryFormat": "SmallestPalette",
          "spaceOptimization": "storage"
        }
      ]
    }
  }
}
